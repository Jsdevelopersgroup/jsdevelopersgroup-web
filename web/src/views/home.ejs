<%- include('partials/head', { title, description }) %>
<%- include('partials/header', { activePage }) %>

<div class="flex flex-col">
  <!-- 1. HERO SECTION -->
  <section class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
    <!-- Background Video -->
    <div class="absolute inset-0 z-0">
      <video
        class="absolute inset-0 z-0 w-full h-full object-cover"
        muted
        loop
        playsinline
        autoplay
        preload="auto"
        poster="/Hero.jpg"
        style="pointer-events: none; filter: brightness(1) blur(1px);">
        <source src="/Hero.mp4" type="video/mp4">
      </video>
      <!-- Overlay -->
      <div class="absolute inset-0 bg-black/60 dark:bg-black/75"></div>
    </div>

    <!-- Hero Content -->
    <div class="container mx-auto px-4 relative z-10 text-center text-white">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
        Building Excellence, <br>
        <span class="text-primary">Crafting Dreams</span>
      </h1>

      <p class="text-lg md:text-xl max-w-2xl mx-auto mb-8">
        Vertex Construction Group delivers exceptional building solutions with
        precision engineering, sustainable innovation, and uncompromising quality for your
        residential, commercial, and industrial projects.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/contact" 
          class="min-w-[160px] inline-flex items-center justify-center rounded-full text-base font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8 py-2">
          Get your 3D Design Online
        </a>
        <a 
          href="/projects" 
          class="min-w-[160px] inline-flex items-center justify-center rounded-full text-base font-medium transition-colors border border-white/20 bg-background/10 backdrop-blur-sm hover:bg-background/20 text-white h-11 px-8 py-2 group">
          Our Projects
          <i data-lucide="chevron-right" class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
      <div class="w-6 h-10 rounded-full border-2 border-white flex items-start justify-center p-1 animate-pulse">
        <div class="w-1 h-2 bg-white rounded-full mt-1"></div>
      </div>
    </div>
  </section>

  <!-- 2. SERVICES OVERVIEW SECTION -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          Our Construction Services
        </h2>
        <p class="text-muted-foreground text-lg">
          We offer a comprehensive range of construction services to meet
          all your building needs.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Service 1 -->
        <div class="bg-card rounded-lg border shadow-sm p-6 flex flex-col justify-between h-full transition-all hover:shadow-md">
          <div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <i data-lucide="home" class="h-6 w-6 text-primary"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Residential Construction</h3>
            <p class="text-muted-foreground text-sm">
              Custom homes and renovations tailored to your lifestyle and preferences.
            </p>
          </div>
          <div class="pt-4">
            <a href="/services#residential" class="inline-flex items-center text-sm font-medium text-foreground hover:text-primary transition-colors">
              Learn More <i data-lucide="chevron-right" class="ml-1 h-4 w-4"></i>
            </a>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="bg-card rounded-lg border shadow-sm p-6 flex flex-col justify-between h-full transition-all hover:shadow-md">
          <div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <i data-lucide="building-2" class="h-6 w-6 text-primary"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Commercial Construction</h3>
            <p class="text-muted-foreground text-sm">
              Office buildings, retail spaces, and commercial facilities built to specification.
            </p>
          </div>
          <div class="pt-4">
            <a href="/services#commercial" class="inline-flex items-center text-sm font-medium text-foreground hover:text-primary transition-colors">
              Learn More <i data-lucide="chevron-right" class="ml-1 h-4 w-4"></i>
            </a>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="bg-card rounded-lg border shadow-sm p-6 flex flex-col justify-between h-full transition-all hover:shadow-md">
          <div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <i data-lucide="warehouse" class="h-6 w-6 text-primary"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Industrial Construction</h3>
            <p class="text-muted-foreground text-sm">
              Warehouses, factories, and industrial facilities designed for efficiency.
            </p>
          </div>
          <div class="pt-4">
            <a href="/services#industrial" class="inline-flex items-center text-sm font-medium text-foreground hover:text-primary transition-colors">
              Learn More <i data-lucide="chevron-right" class="ml-1 h-4 w-4"></i>
            </a>
          </div>
        </div>

        <!-- Service 4 -->
        <div class="bg-card rounded-lg border shadow-sm p-6 flex flex-col justify-between h-full transition-all hover:shadow-md">
          <div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <i data-lucide="wrench" class="h-6 w-6 text-primary"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Renovation & Remodeling</h3>
            <p class="text-muted-foreground text-sm">
              Transform your existing space with our expert renovation services.
            </p>
          </div>
          <div class="pt-4">
            <a href="/services#renovation" class="inline-flex items-center text-sm font-medium text-foreground hover:text-primary transition-colors">
              Learn More <i data-lucide="chevron-right" class="ml-1 h-4 w-4"></i>
            </a>
          </div>
        </div>

        <!-- Service 5 -->
        <div class="bg-card rounded-lg border shadow-sm p-6 flex flex-col justify-between h-full transition-all hover:shadow-md">
          <div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <i data-lucide="hard-hat" class="h-6 w-6 text-primary"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Project Management</h3>
            <p class="text-muted-foreground text-sm">
              Comprehensive project management from planning to completion.
            </p>
          </div>
          <div class="pt-4">
            <a href="/services#management" class="inline-flex items-center text-sm font-medium text-foreground hover:text-primary transition-colors">
              Learn More <i data-lucide="chevron-right" class="ml-1 h-4 w-4"></i>
            </a>
          </div>
        </div>

        <!-- Service 6 -->
        <div class="bg-card rounded-lg border shadow-sm p-6 flex flex-col justify-between h-full transition-all hover:shadow-md">
          <div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <i data-lucide="ruler" class="h-6 w-6 text-primary"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Design & Planning</h3>
            <p class="text-muted-foreground text-sm">
              Architectural design and planning services to bring your vision to life.
            </p>
          </div>
          <div class="pt-4">
            <a href="/services#design" class="inline-flex items-center text-sm font-medium text-foreground hover:text-primary transition-colors">
              Learn More <i data-lucide="chevron-right" class="ml-1 h-4 w-4"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="text-center mt-12">
        <a 
          href="/services" 
          class="inline-flex items-center justify-center rounded-md text-base font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8 py-2">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- 3. STATS SECTION -->
  <section class="py-16 md:py-24 bg-muted/30">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4">
            <i data-lucide="building" class="h-8 w-8 text-primary"></i>
          </div>
          <h3 class="text-3xl md:text-4xl font-bold mb-2">150+</h3>
          <p class="text-muted-foreground">Projects Completed</p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4">
            <i data-lucide="calendar" class="h-8 w-8 text-primary"></i>
          </div>
          <h3 class="text-3xl md:text-4xl font-bold mb-2">25+</h3>
          <p class="text-muted-foreground">Years of Experience</p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4">
            <i data-lucide="users" class="h-8 w-8 text-primary"></i>
          </div>
          <h3 class="text-3xl md:text-4xl font-bold mb-2">50+</h3>
          <p class="text-muted-foreground">Team Members</p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4">
            <i data-lucide="award" class="h-8 w-8 text-primary"></i>
          </div>
          <h3 class="text-3xl md:text-4xl font-bold mb-2">15+</h3>
          <p class="text-muted-foreground">Industry Awards</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FEATURED PROJECTS SECTION -->
  <section class="py-16 md:py-24 bg-muted/30">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Featured Projects</h2>
          <p class="text-muted-foreground text-lg">
            Explore our portfolio of completed projects showcasing our
            expertise and commitment to quality.
          </p>
        </div>

        <div class="mt-4 md:mt-0">
          <a 
            href="/projects" 
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 group">
            View All Projects
            <i data-lucide="arrow-right" class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"></i>
          </a>
        </div>
      </div>

      <% if (!featuredProjects || featuredProjects.length === 0) { %>
        <div class="text-center py-12">
          <p class="text-muted-foreground text-lg">No featured projects available at the moment.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% featuredProjects.forEach(project => { %>
            <div>
              <a href="/projects/<%= project.id %>" class="group block">
                <div class="relative overflow-hidden rounded-lg">
                  <div class="aspect-[4/3] bg-muted">
                    <img 
                      src="<%= project.image_url || '/placeholder.svg' %>" 
                      alt="<%= project.title %>"
                      class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110"
                      loading="lazy"
                    />
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-80"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-6">
                    <span class="inline-block px-3 py-1 text-xs font-medium bg-primary text-primary-foreground rounded-full mb-2">
                      <%= project.category %>
                    </span>
                    <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">
                      <%= project.title %>
                    </h3>
                  </div>
                </div>
              </a>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- 5. AWARDS & RECOGNITION (TESTIMONIALS) -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Awards & Recognition</h2>
        <p class="text-muted-foreground text-lg">
          Honoring milestones, achievements, and recognitions received for excellence in contracting and public infrastructure projects.
        </p>
      </div>

      <div class="relative max-w-4xl mx-auto" id="testimonials-carousel">
        <!-- Slide 0 -->
        <div class="testimonial-slide bg-card rounded-lg shadow-lg p-8 md:p-12 border dark:shadow-white/5 transition-all duration-300">
          <i data-lucide="quote" class="h-12 w-12 text-primary/20 mb-6"></i>
          <p class="text-xl md:text-2xl italic mb-8">
            "Awarded for 15+ years of structural excellence, safety compliance, and uninterrupted contracting leadership."
          </p>
          <div class="flex items-center">
            <div class="relative w-16 h-16 rounded-full overflow-hidden mr-4 shrink-0 bg-muted">
              <img src="/testimonials/award_contracting.jpeg" alt="Regional Infrastructure Authority" class="object-cover w-full h-full">
            </div>
            <div>
              <h4 class="font-bold text-lg">Regional Infrastructure Authority</h4>
              <p class="text-muted-foreground">Annual Civil Excellence Citation</p>
            </div>
          </div>
        </div>

        <!-- Slide 1 -->
        <div class="testimonial-slide hidden bg-card rounded-lg shadow-lg p-8 md:p-12 border dark:shadow-white/5 transition-all duration-300">
          <i data-lucide="quote" class="h-12 w-12 text-primary/20 mb-6"></i>
          <p class="text-xl md:text-2xl italic mb-8">
            "Recognized for the successful turnkey delivery of the Metropolitan Healthcare Research Complex."
          </p>
          <div class="flex items-center">
            <div class="relative w-16 h-16 rounded-full overflow-hidden mr-4 shrink-0 bg-muted">
              <img src="/testimonials/award_healthcare.jpeg" alt="Healthcare Infrastructure Council" class="object-cover w-full h-full">
            </div>
            <div>
              <h4 class="font-bold text-lg">Healthcare Infrastructure Council</h4>
              <p class="text-muted-foreground">Special Engineering Commendation</p>
            </div>
          </div>
        </div>

        <!-- Carousel Dots -->
        <div class="flex justify-center mt-8 space-x-2">
          <button type="button" class="carousel-dot w-3 h-3 rounded-full bg-primary transition-colors" aria-label="Slide 1"></button>
          <button type="button" class="carousel-dot w-3 h-3 rounded-full bg-muted-foreground/30 transition-colors" aria-label="Slide 2"></button>
        </div>

        <!-- Carousel Arrows -->
        <button 
          id="testimonial-prev"
          type="button" 
          class="absolute top-1/2 -translate-y-1/2 -left-4 md:-left-6 rounded-full bg-background shadow-md border w-10 h-10 inline-flex items-center justify-center hover:bg-muted transition-colors"
          aria-label="Previous testimonial">
          <i data-lucide="chevron-left" class="h-5 w-5"></i>
        </button>

        <button 
          id="testimonial-next"
          type="button" 
          class="absolute top-1/2 -translate-y-1/2 -right-4 md:-right-6 rounded-full bg-background shadow-md border w-10 h-10 inline-flex items-center justify-center hover:bg-muted transition-colors"
          aria-label="Next testimonial">
          <i data-lucide="chevron-right" class="h-5 w-5"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- 6. CALL TO ACTION -->
  <section class="py-16 md:py-24 bg-primary text-primary-foreground">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          Ready to Start Your Construction Project?
        </h2>
        <p class="text-xl opacity-90 mb-8">
          Contact us today for a free consultation and quote. Let's build
          something great together.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/contact" 
            class="min-w-[180px] inline-flex items-center justify-center rounded-md text-base font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-11 px-8 py-2">
            Get a Quote
          </a>
          <a 
            href="tel:+15552345678" 
            class="min-w-[180px] inline-flex items-center justify-center rounded-md text-base font-medium transition-colors border border-primary-foreground/20 hover:bg-primary-foreground/10 text-white h-11 px-8 py-2">
            <i data-lucide="phone" class="mr-2 h-4 w-4"></i> Call Us
          </a>
        </div>

        <div class="mt-8">
          <p class="flex items-center justify-center">
            <i data-lucide="mail" class="mr-2 h-5 w-5"></i>
            <a href="mailto:info@vertexconstruction.local" class="hover:underline">
              info@vertexconstruction.local
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
