<%- include('partials/head', { title, description }) %>
<%- include('partials/header', { activePage }) %>

<div class="flex flex-col gap-20 pb-20">
  <!-- 1. CONTACT HERO -->
  <section class="relative h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1516387938699-a93567ec168e?q=80&w=2071&auto=format&fit=crop"
        alt="Contact us"
        class="w-full h-full object-cover"
        style="filter: brightness(0.5);"
      />
      <div class="absolute inset-0 bg-black/40 dark:bg-black/60"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 text-center text-white">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 drop-shadow-md">
        Contact Us
      </h1>
      <p class="text-lg md:text-xl max-w-2xl mx-auto drop-shadow-md">
        Get in touch with our team to discuss your construction project needs.
      </p>
    </div>
  </section>

  <!-- 2. CONTACT CONTENT -->
  <div class="container mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-12">
    <!-- Form Side -->
    <div>
      <h2 class="text-2xl font-bold mb-6">Send Us a Message</h2>

      <div id="contact-success" class="hidden bg-green-100 dark:bg-green-900/30 p-6 rounded-lg text-center border border-green-500/30">
        <h3 class="text-xl font-bold mb-2 text-green-800 dark:text-green-300">Thank You!</h3>
        <p class="text-green-700 dark:text-green-200">
          Your message has been formatted for WhatsApp. We'll get back to you soon.
        </p>
      </div>

      <form id="contact-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block mb-2 text-sm font-medium">Your Name</label>
            <input 
              id="name" 
              name="name" 
              required 
              placeholder="John Doe"
              class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            />
          </div>

          <div>
            <label for="email" class="block mb-2 text-sm font-medium">Email Address</label>
            <input 
              id="email" 
              name="email" 
              type="email" 
              required 
              placeholder="john@example.com"
              class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block mb-2 text-sm font-medium">Subject</label>
          <input 
            id="subject" 
            name="subject" 
            required 
            placeholder="Project Inquiry"
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>

        <div>
          <label for="message" class="block mb-2 text-sm font-medium">Message</label>
          <textarea 
            id="message" 
            name="message" 
            required 
            rows="6"
            placeholder="Tell us about your project and requirements..."
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring resize-y"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full md:w-auto inline-flex items-center justify-center rounded-md text-sm font-medium h-10 px-6 py-2 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors shadow">
          Send via WhatsApp
        </button>
      </form>
    </div>

    <!-- Info & Map Side -->
    <div class="space-y-12">
      <!-- Contact Info -->
      <div>
        <h2 class="text-2xl font-bold mb-6">Contact Information</h2>

        <div class="space-y-6">
          <div class="flex items-start">
            <div class="mt-1 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mr-4 shrink-0">
              <i data-lucide="map-pin" class="h-5 w-5 text-primary"></i>
            </div>
            <div>
              <h3 class="font-bold">Address</h3>
              <p class="text-muted-foreground leading-relaxed">
                CA Mall, Near Mathoth<br>
                Kovalpally, Kanhangad South<br>
                Kasargod, Kerala – 671531<br>
                India
              </p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="mt-1 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mr-4 shrink-0">
              <i data-lucide="phone" class="h-5 w-5 text-primary"></i>
            </div>
            <div>
              <h3 class="font-bold">Phone Number</h3>
              <p class="text-muted-foreground">
                <a href="tel:+919961660463" class="hover:text-primary transition-colors">
                  +91 9961660463
                </a>
              </p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="mt-1 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mr-4 shrink-0">
              <i data-lucide="mail" class="h-5 w-5 text-primary"></i>
            </div>
            <div>
              <h3 class="font-bold">Email</h3>
              <p class="text-muted-foreground">
                <a href="mailto:info@Jsdevelopersgroup.com" class="hover:text-primary transition-colors">
                  info@Jsdevelopersgroup.com
                </a>
              </p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="mt-1 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mr-4 shrink-0">
              <i data-lucide="clock" class="h-5 w-5 text-primary"></i>
            </div>
            <div>
              <h3 class="font-bold">Business Hours</h3>
              <p class="text-muted-foreground leading-relaxed">
                Monday - Friday: 8:00 AM - 6:00 PM<br>
                Saturday: 9:00 AM - 2:00 PM<br>
                Sunday: Closed
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed -->
      <div class="h-80 bg-muted rounded-lg overflow-hidden border shadow-sm">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d487.2823252654766!2d75.10153295034223!3d12.298363876786448!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba47b7c5c68ee4b%3A0xb4677332794628b5!2sCA%20mall!5e0!3m2!1sen!2sin!4v1771441141014!5m2!1sen!2sin"
          width="100%"
          height="100%"
          style="border: 0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
