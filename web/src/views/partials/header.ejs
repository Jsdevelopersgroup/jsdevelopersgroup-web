<% 
  const current = typeof activePage !== 'undefined' ? activePage : '';
  const whatsappQuoteUrl = "https://wa.me/15552345678?text=Hello%2C%20I%20want%20to%20inquire%20about%20your%20services.";
%>
<header id="main-header" class="fixed top-0 w-full z-50 transition-all duration-300 bg-transparent">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16 md:h-24">
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center space-x-2">
        <div>
          <img 
            src="/logo.png" 
            alt="Vertex" 
            class="site-logo w-16 sm:w-28 transition-all duration-300 invert"
          />
        </div>
        <span class="site-brand-text font-bold text-xl hidden sm:block text-white transition-colors">
          Vertex Construction Group
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1">
        <a 
          href="/" 
          class="nav-link px-3 py-2 rounded-md text-sm font-medium transition-colors relative group <%= current === 'home' ? 'text-white' : 'text-white/90 hover:text-white' %>"
          data-active="<%= current === 'home' ? 'true' : 'false' %>">
          Home
          <% if (current === 'home') { %>
            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-white"></div>
          <% } %>
        </a>

        <a 
          href="/about" 
          class="nav-link px-3 py-2 rounded-md text-sm font-medium transition-colors relative group <%= current === 'about' ? 'text-white' : 'text-white/90 hover:text-white' %>"
          data-active="<%= current === 'about' ? 'true' : 'false' %>">
          About
          <% if (current === 'about') { %>
            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-white"></div>
          <% } %>
        </a>

        <a 
          href="/services" 
          class="nav-link px-3 py-2 rounded-md text-sm font-medium transition-colors relative group <%= current === 'services' ? 'text-white' : 'text-white/90 hover:text-white' %>"
          data-active="<%= current === 'services' ? 'true' : 'false' %>">
          Services
          <% if (current === 'services') { %>
            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-white"></div>
          <% } %>
        </a>

        <a 
          href="/projects" 
          class="nav-link px-3 py-2 rounded-md text-sm font-medium transition-colors relative group <%= current === 'projects' ? 'text-white' : 'text-white/90 hover:text-white' %>"
          data-active="<%= current === 'projects' ? 'true' : 'false' %>">
          Projects
          <% if (current === 'projects') { %>
            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-white"></div>
          <% } %>
        </a>

        <a 
          href="/contact" 
          class="nav-link px-3 py-2 rounded-md text-sm font-medium transition-colors relative group <%= current === 'contact' ? 'text-white' : 'text-white/90 hover:text-white' %>"
          data-active="<%= current === 'contact' ? 'true' : 'false' %>">
          Contact
          <% if (current === 'contact') { %>
            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-white"></div>
          <% } %>
        </a>

        <!-- Theme Toggle Desktop -->
        <div class="pl-2">
          <button 
            type="button" 
            class="theme-toggle-btn p-2 rounded-md text-white hover:text-white/80 transition-colors inline-flex items-center justify-center"
            aria-label="Toggle theme">
            <i data-lucide="sun" class="h-5 w-5 hidden dark:block"></i>
            <i data-lucide="moon" class="h-5 w-5 block dark:hidden"></i>
          </button>
        </div>

        <!-- Get a Quote Button Desktop -->
        <a 
          href="<%= whatsappQuoteUrl %>" 
          target="_blank"
          rel="noopener noreferrer"
          class="ml-4 inline-flex items-center justify-center rounded-full text-sm font-medium transition-colors bg-white text-primary hover:bg-white/90 h-9 px-4 py-2">
          Get a Quote
        </a>
      </nav>

      <!-- Mobile Navigation Controls -->
      <div class="flex items-center md:hidden space-x-2">
        <button 
          type="button" 
          class="theme-toggle-btn p-2 rounded-md text-white hover:text-white/80 transition-colors inline-flex items-center justify-center"
          aria-label="Toggle theme">
          <i data-lucide="sun" class="h-5 w-5 hidden dark:block"></i>
          <i data-lucide="moon" class="h-5 w-5 block dark:hidden"></i>
        </button>

        <button 
          id="mobile-menu-toggle" 
          type="button" 
          class="p-2 rounded-md text-white hover:text-white/80 transition-colors"
          aria-label="Toggle menu">
          <span class="menu-icon block"><i data-lucide="menu" class="h-6 w-6"></i></span>
          <span class="close-icon hidden"><i data-lucide="x" class="h-6 w-6"></i></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-background border-t">
    <div class="container mx-auto px-4 py-4 space-y-2">
      <a 
        href="/" 
        class="block px-3 py-2 rounded-md text-base font-medium <%= current === 'home' ? 'bg-primary/10 text-primary' : 'hover:bg-muted' %>">
        Home
      </a>
      <a 
        href="/about" 
        class="block px-3 py-2 rounded-md text-base font-medium <%= current === 'about' ? 'bg-primary/10 text-primary' : 'hover:bg-muted' %>">
        About
      </a>
      <a 
        href="/services" 
        class="block px-3 py-2 rounded-md text-base font-medium <%= current === 'services' ? 'bg-primary/10 text-primary' : 'hover:bg-muted' %>">
        Services
      </a>
      <a 
        href="/projects" 
        class="block px-3 py-2 rounded-md text-base font-medium <%= current === 'projects' ? 'bg-primary/10 text-primary' : 'hover:bg-muted' %>">
        Projects
      </a>
      <a 
        href="/contact" 
        class="block px-3 py-2 rounded-md text-base font-medium <%= current === 'contact' ? 'bg-primary/10 text-primary' : 'hover:bg-muted' %>">
        Contact
      </a>
      <div class="pt-2">
        <a 
          href="/contact" 
          class="w-full inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
          Get a Quote
        </a>
      </div>
    </div>
  </div>
</header>
<main class="flex-1">
