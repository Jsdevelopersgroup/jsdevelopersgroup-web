<%- include('partials/head', { title, description }) %>
<%- include('partials/header', { activePage }) %>

<div class="container mx-auto px-4 py-32 text-center flex-1 flex flex-col items-center justify-center min-h-[60vh]">
  <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary/10 mb-6">
    <i data-lucide="hard-hat" class="h-10 w-10 text-primary"></i>
  </div>
  <h1 class="text-4xl md:text-6xl font-bold mb-4">404</h1>
  <h2 class="text-2xl font-semibold mb-4">Page Not Found</h2>
  <p class="text-muted-foreground max-w-md mx-auto mb-8">
    The page you are looking for does not exist or has been moved.
  </p>
  <a 
    href="/" 
    class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-6 py-2 transition-colors">
    Back to Home
  </a>
</div>

<%- include('partials/footer') %>
