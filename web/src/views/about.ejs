<%- include('partials/head', { title, description }) %>
<%- include('partials/header', { activePage }) %>

<div class="flex flex-col gap-20 pb-20">
  <!-- 1. ABOUT HERO -->
  <section class="relative h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.pexels.com/photos/585418/pexels-photo-585418.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" 
        alt="Construction team"
        class="w-full h-full object-cover"
        style="filter: brightness(0.6);"
      />
      <div class="absolute inset-0 bg-black/40 dark:bg-black/60"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 text-center text-white">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
        About Vertex Construction Group
      </h1>
      <p class="text-lg md:text-xl max-w-2xl mx-auto">
        Building excellence with precision engineering and structural integrity since 1988. Your vision, our expertise.
      </p>
    </div>
  </section>

  <!-- 2. MISSION & VISION -->
  <section class="py-8 md:py-12">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Mission -->
        <div class="bg-card rounded-lg p-8 shadow-lg border">
          <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-6">
            <i data-lucide="target" class="h-8 w-8 text-primary"></i>
          </div>
          <h2 class="text-2xl font-bold mb-4">Our Mission</h2>
          <p class="text-muted-foreground leading-relaxed">
            To deliver exceptional construction services that exceed client
            expectations through innovation, quality craftsmanship, and
            unwavering commitment to excellence. We strive to build not just
            structures, but lasting relationships based on trust, integrity,
            and superior results.
          </p>
        </div>

        <!-- Vision -->
        <div class="bg-card rounded-lg p-8 shadow-lg border">
          <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-6">
            <i data-lucide="eye" class="h-8 w-8 text-primary"></i>
          </div>
          <h2 class="text-2xl font-bold mb-4">Our Vision</h2>
          <p class="text-muted-foreground leading-relaxed">
            To be the leading construction company recognized for transforming
            the built environment through sustainable practices, innovative
            solutions, and exceptional service. We aim to set new standards in
            the industry while creating spaces that enhance lives and
            communities for generations to come.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CORE VALUES -->
  <section class="py-8 md:py-12">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Our Core Values</h2>
        <p class="text-muted-foreground text-lg">
          These principles guide our decisions, shape our culture, and define
          how we deliver value to our clients.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-card rounded-lg p-6 shadow-md border h-full">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <i data-lucide="shield" class="h-6 w-6 text-primary"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">Integrity</h3>
          <p class="text-muted-foreground">We conduct business with honesty, transparency, and ethical standards in all our interactions.</p>
        </div>

        <div class="bg-card rounded-lg p-6 shadow-md border h-full">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <i data-lucide="sparkles" class="h-6 w-6 text-primary"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">Excellence</h3>
          <p class="text-muted-foreground">We strive for excellence in every aspect of our work, from planning to execution and delivery.</p>
        </div>

        <div class="bg-card rounded-lg p-6 shadow-md border h-full">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <i data-lucide="lightbulb" class="h-6 w-6 text-primary"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">Innovation</h3>
          <p class="text-muted-foreground">We embrace innovative solutions and technologies to deliver superior construction results.</p>
        </div>

        <div class="bg-card rounded-lg p-6 shadow-md border h-full">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <i data-lucide="users" class="h-6 w-6 text-primary"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">Teamwork</h3>
          <p class="text-muted-foreground">We believe in collaborative efforts and the power of working together to achieve common goals.</p>
        </div>

        <div class="bg-card rounded-lg p-6 shadow-md border h-full">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <i data-lucide="clock" class="h-6 w-6 text-primary"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">Reliability</h3>
          <p class="text-muted-foreground">We are committed to delivering projects on time, within budget, and to the highest standards.</p>
        </div>

        <div class="bg-card rounded-lg p-6 shadow-md border h-full">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <i data-lucide="heart" class="h-6 w-6 text-primary"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">Client Focus</h3>
          <p class="text-muted-foreground">We prioritize our clients' needs and satisfaction in every project we undertake.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. MEET OUR TEAM -->
  <section class="py-16 md:py-24 bg-muted/30">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Meet Our Team</h2>
        <p class="text-muted-foreground text-lg">
          Our experienced team of professionals is dedicated to bringing your
          construction vision to life.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl mx-auto">
        <!-- Team 1 -->
        <div class="bg-card rounded-lg overflow-hidden shadow-md transition-transform hover:shadow-lg">
          <div class="relative h-80 bg-muted">
            <img src="/team/founder.jpeg" alt="Arthur Vance" class="object-cover w-full h-full">
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold">Arthur Vance</h3>
            <p class="text-primary font-medium mb-3">Founder & Executive Chairman</p>
            <p class="text-muted-foreground text-sm mb-4 leading-relaxed">
              With over 35 years of civil engineering and construction leadership, Arthur founded the firm with a relentless commitment to structural integrity, transparent costing, and client trust across commercial and municipal projects.
            </p>
            <div class="flex space-x-3">
              <a href="#" class="text-muted-foreground hover:text-primary transition-colors"><i data-lucide="linkedin" class="h-4 w-4"></i></a>
              <a href="#" class="text-muted-foreground hover:text-primary transition-colors"><i data-lucide="twitter" class="h-4 w-4"></i></a>
              <a href="mailto:contact@vertexconstruction.local" class="text-muted-foreground hover:text-primary transition-colors"><i data-lucide="mail" class="h-4 w-4"></i></a>
            </div>
          </div>
        </div>

        <!-- Team 2 -->
        <div class="bg-card rounded-lg overflow-hidden shadow-md transition-transform hover:shadow-lg">
          <div class="relative h-80 bg-muted">
            <img src="/team/CEO.jpeg" alt="Marcus Sterling, P.E." class="object-cover w-full h-full">
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold">Marcus Sterling, P.E.</h3>
            <p class="text-primary font-medium mb-3">Chief Operating Officer</p>
            <p class="text-muted-foreground text-sm mb-4 leading-relaxed">
              Licensed Professional Engineer holding an M.Sc in Civil and Structural Engineering. Leads modern BIM execution, rigorous seismic standards, sustainable precast technology, and turnkey commercial delivery.
            </p>
            <div class="flex space-x-3">
              <a href="#" class="text-muted-foreground hover:text-primary transition-colors"><i data-lucide="linkedin" class="h-4 w-4"></i></a>
              <a href="#" class="text-muted-foreground hover:text-primary transition-colors"><i data-lucide="twitter" class="h-4 w-4"></i></a>
              <a href="mailto:info@vertexconstruction.local" class="text-muted-foreground hover:text-primary transition-colors"><i data-lucide="mail" class="h-4 w-4"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. TIMELINE / OUR JOURNEY -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Our Journey</h2>
        <p class="text-muted-foreground text-lg">
          From our humble beginnings to becoming an industry leader, explore
          the key milestones in our company's history.
        </p>
      </div>

      <div class="relative max-w-5xl mx-auto">
        <!-- Timeline vertical line -->
        <div class="absolute left-0 md:left-1/2 transform md:-translate-x-1/2 h-full w-1 bg-muted"></div>

        <div class="space-y-12">
          <!-- Milestone 1 -->
          <div class="relative flex flex-col md:flex-row items-center md:flex-row-reverse">
            <div class="flex-1 md:w-1/2 p-6">
              <div class="bg-card rounded-lg p-6 shadow-md border">
                <div class="text-primary font-bold text-xl mb-2">1988</div>
                <h3 class="text-xl font-bold mb-2">Company Founded</h3>
                <p class="text-muted-foreground">Arthur Vance founded the company as a regional civil construction firm, establishing a steadfast reputation for structural excellence and safety.</p>
              </div>
            </div>
            <div class="md:w-16 flex justify-center">
              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center z-10 text-primary-foreground font-bold text-xs">
                <i data-lucide="calendar" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="flex-1 md:w-1/2 hidden md:block"></div>
          </div>

          <!-- Milestone 2 -->
          <div class="relative flex flex-col md:flex-row items-center">
            <div class="flex-1 md:w-1/2 p-6">
              <div class="bg-card rounded-lg p-6 shadow-md border">
                <div class="text-primary font-bold text-xl mb-2">2002</div>
                <h3 class="text-xl font-bold mb-2">Excellence in Contracting Award</h3>
                <p class="text-muted-foreground">Honored with the Regional Construction Excellence Citation for 15 consecutive years of consistent structural quality, safety records, and reliable delivery.</p>
              </div>
            </div>
            <div class="md:w-16 flex justify-center">
              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center z-10 text-primary-foreground font-bold text-xs">
                <i data-lucide="award" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="flex-1 md:w-1/2 hidden md:block"></div>
          </div>

          <!-- Milestone 3 -->
          <div class="relative flex flex-col md:flex-row items-center md:flex-row-reverse">
            <div class="flex-1 md:w-1/2 p-6">
              <div class="bg-card rounded-lg p-6 shadow-md border">
                <div class="text-primary font-bold text-xl mb-2">2006 - 2012</div>
                <h3 class="text-xl font-bold mb-2">Public & Institutional Infrastructure</h3>
                <p class="text-muted-foreground">Expanded footprint into large-scale civic works, municipal research complexes, educational wings, and commercial logistics hubs across the territory.</p>
              </div>
            </div>
            <div class="md:w-16 flex justify-center">
              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center z-10 text-primary-foreground font-bold text-xs">
                <i data-lucide="building" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="flex-1 md:w-1/2 hidden md:block"></div>
          </div>

          <!-- Milestone 4 -->
          <div class="relative flex flex-col md:flex-row items-center">
            <div class="flex-1 md:w-1/2 p-6">
              <div class="bg-card rounded-lg p-6 shadow-md border">
                <div class="text-primary font-bold text-xl mb-2">2016 - 2019</div>
                <h3 class="text-xl font-bold mb-2">Sustainable & Modern Construction</h3>
                <p class="text-muted-foreground">Pioneered LEED-compliant sustainable practices, energy-efficient HVAC integration, and pre-stressed concrete engineering for high-density urban projects.</p>
              </div>
            </div>
            <div class="md:w-16 flex justify-center">
              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center z-10 text-primary-foreground font-bold text-xs">
                <i data-lucide="hard-hat" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="flex-1 md:w-1/2 hidden md:block"></div>
          </div>

          <!-- Milestone 5 -->
          <div class="relative flex flex-col md:flex-row items-center md:flex-row-reverse">
            <div class="flex-1 md:w-1/2 p-6">
              <div class="bg-card rounded-lg p-6 shadow-md border">
                <div class="text-primary font-bold text-xl mb-2">2022</div>
                <h3 class="text-xl font-bold mb-2">Digital Transformation & Evolution</h3>
                <p class="text-muted-foreground">Evolved into Vertex Construction Group, deploying modern 3D BIM modeling, real-time drone site inspection, and comprehensive turnkey execution.</p>
              </div>
            </div>
            <div class="md:w-16 flex justify-center">
              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center z-10 text-primary-foreground font-bold text-xs">
                <i data-lucide="sparkles" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="flex-1 md:w-1/2 hidden md:block"></div>
          </div>

          <!-- Milestone 6 -->
          <div class="relative flex flex-col md:flex-row items-center">
            <div class="flex-1 md:w-1/2 p-6">
              <div class="bg-card rounded-lg p-6 shadow-md border">
                <div class="text-primary font-bold text-xl mb-2">Today</div>
                <h3 class="text-xl font-bold mb-2">Industry Leader</h3>
                <p class="text-muted-foreground">Recognized as an industry leader with a portfolio of successful projects across multiple sectors.</p>
              </div>
            </div>
            <div class="md:w-16 flex justify-center">
              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center z-10 text-primary-foreground font-bold text-xs">
                <i data-lucide="award" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="flex-1 md:w-1/2 hidden md:block"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
