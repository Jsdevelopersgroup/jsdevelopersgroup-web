<%- include('partials/head', { title, description }) %>
<%- include('partials/header', { activePage }) %>

<% 
  const images = (project.images && project.images.length > 0) ? project.images : [{ image_url: '/placeholder.svg' }];
  const mainHeroImg = images[0].image_url;
  const year = project.project_date ? project.project_date.split('-')[0] : (project.year || '');
%>

<div class="flex flex-col gap-5 sm:gap-10 pb-16">
  <!-- 1. SINGLE PROJECT HERO -->
  <section class="relative h-[40vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="<%= mainHeroImg %>"
        alt="<%= project.title %>"
        class="w-full h-full object-cover"
        style="filter: brightness(0.4);"
      />
      <div class="absolute inset-0 bg-black/30 dark:bg-black/60"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 text-center text-white">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 sm:mb-6 drop-shadow-md">
        <%= project.title %>
      </h1>

      <div class="flex flex-wrap items-center justify-center gap-3 mx-auto">
        <span class="px-3 py-1 text-sm font-medium bg-primary text-primary-foreground rounded-full">
          <%= project.category %>
        </span>

        <% if (year) { %>
          <div class="flex items-center text-white/90 text-sm">
            <i data-lucide="calendar" class="h-4 w-4 mr-1"></i>
            <span><%= year %></span>
          </div>
        <% } %>

        <% if (project.location) { %>
          <div class="flex items-center text-white/90 text-sm">
            <i data-lucide="map-pin" class="h-4 w-4 mr-1"></i>
            <span><%= project.location %></span>
          </div>
        <% } %>

        <% if (project.client) { %>
          <div class="flex items-center text-white/90 text-sm">
            <i data-lucide="building" class="h-4 w-4 mr-1"></i>
            <span><%= project.client %></span>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- 2. PROJECT OVERVIEW -->
  <% if (project.overview) { %>
    <section class="container mx-auto px-4 pt-4 md:pt-10">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-lg md:text-xl tracking-wider leading-relaxed text-muted-foreground whitespace-pre-line">
          <%= project.overview %>
        </p>
      </div>
    </section>
  <% } %>

  <!-- 3. PROJECT GALLERY & LIGHTBOX -->
  <section class="py-10 sm:py-16" id="project-gallery">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold">Project Gallery</h2>
      </div>

      <div class="max-w-5xl mx-auto">
        <!-- Main Viewer -->
        <div class="relative">
          <div class="relative aspect-[16/9] rounded-lg overflow-hidden bg-black/40 border shadow-md flex items-center justify-center">
            <img 
              id="gallery-main-image"
              src="<%= images[0].image_url %>" 
              alt="<%= project.title %> image" 
              class="object-contain w-full h-full cursor-pointer"
            />
            <button 
              id="gallery-maximize"
              type="button" 
              class="absolute top-4 right-4 bg-black/40 hover:bg-black/60 backdrop-blur-sm border border-white/20 text-white rounded-md p-2 transition-colors"
              aria-label="Maximize image">
              <i data-lucide="maximize-2" class="h-5 w-5"></i>
            </button>
          </div>

          <!-- Gallery Arrows -->
          <button 
            id="gallery-prev"
            type="button" 
            class="absolute top-1/2 -translate-y-1/2 -left-4 md:-left-6 rounded-full bg-background shadow-md border w-10 h-10 inline-flex items-center justify-center hover:bg-muted transition-colors"
            aria-label="Previous image">
            <i data-lucide="chevron-left" class="h-5 w-5"></i>
          </button>

          <button 
            id="gallery-next"
            type="button" 
            class="absolute top-1/2 -translate-y-1/2 -right-4 md:-right-6 rounded-full bg-background shadow-md border w-10 h-10 inline-flex items-center justify-center hover:bg-muted transition-colors"
            aria-label="Next image">
            <i data-lucide="chevron-right" class="h-5 w-5"></i>
          </button>
        </div>

        <!-- Thumbnails Strip -->
        <div class="grid grid-cols-5 gap-2 mt-4">
          <% images.forEach((img, idx) => { %>
            <button 
              type="button" 
              class="gallery-thumb relative aspect-[4/3] rounded-md overflow-hidden bg-muted transition-all <%= idx === 0 ? 'ring-2 ring-primary opacity-100' : 'opacity-70 hover:opacity-100' %>"
              data-src="<%= img.image_url %>"
              aria-label="Thumbnail <%= idx + 1 %>">
              <img src="<%= img.image_url %>" alt="Thumbnail <%= idx + 1 %>" class="object-cover w-full h-full">
            </button>
          <% }); %>
        </div>
      </div>
    </div>
  </section>

  <!-- Fullscreen Lightbox Modal -->
  <div id="project-lightbox" class="lightbox-backdrop hidden fixed inset-0 z-50 bg-black/90 items-center justify-center p-4">
    <div class="relative max-w-7xl max-h-[90vh] w-[90vw] flex items-center justify-center">
      <img id="lightbox-image" src="<%= images[0].image_url %>" alt="Enlarged view" class="max-h-[85vh] max-w-full object-contain mx-auto rounded-md shadow-2xl">

      <button 
        id="lightbox-prev" 
        type="button" 
        class="absolute top-1/2 -translate-y-1/2 left-2 md:left-6 rounded-full bg-black/40 hover:bg-black/60 border border-white/20 text-white w-12 h-12 inline-flex items-center justify-center transition-colors"
        aria-label="Previous">
        <i data-lucide="chevron-left" class="h-6 w-6"></i>
      </button>

      <button 
        id="lightbox-next" 
        type="button" 
        class="absolute top-1/2 -translate-y-1/2 right-2 md:right-6 rounded-full bg-black/40 hover:bg-black/60 border border-white/20 text-white w-12 h-12 inline-flex items-center justify-center transition-colors"
        aria-label="Next">
        <i data-lucide="chevron-right" class="h-6 w-6"></i>
      </button>

      <button 
        id="lightbox-close" 
        type="button" 
        class="absolute -top-12 right-0 md:top-2 md:right-2 rounded-full bg-black/40 hover:bg-black/60 border border-white/20 text-white w-10 h-10 inline-flex items-center justify-center transition-colors"
        aria-label="Close lightbox">
        <i data-lucide="x" class="h-5 w-5"></i>
      </button>
    </div>
  </div>

  <!-- 4. PROJECT SPECIFICATIONS -->
  <% if (project.specifications && project.specifications.length > 0) { %>
    <section class="py-10 sm:py-16">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold">Project Specifications</h2>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% project.specifications.forEach(spec => { 
                 let iconName = (spec.icon_name || 'building-2').toLowerCase().replace(/\s+/g, '-');
                 if (iconName === 'building2') iconName = 'building-2';
                 if (iconName === 'dollarsign') iconName = 'dollar-sign';
                 if (iconName === 'checkcircle') iconName = 'check-circle';
            %>
              <div class="bg-card rounded-lg border shadow-sm p-6">
                <div class="flex items-center text-lg font-semibold mb-2">
                  <i data-lucide="<%= iconName %>" class="h-5 w-5 mr-2 text-primary"></i>
                  <span><%= spec.title %></span>
                </div>
                <p class="text-xl font-bold text-foreground"><%= spec.value %></p>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>
