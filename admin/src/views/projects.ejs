<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 py-8 space-y-6 flex-1 w-full">
  <!-- Top Bar -->
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Projects</h1>
    <button 
      id="btn-add-project"
      type="button" 
      class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 transition-colors shadow-sm">
      <i data-lucide="plus" class="h-4 w-4 mr-1.5"></i>
      Add Project
    </button>
  </div>

  <!-- Notification Toast Box -->
  <div id="admin-toast" class="hidden fixed bottom-6 right-6 z-50 bg-card border shadow-lg rounded-lg p-4 max-w-sm transition-all duration-300">
    <div class="flex items-center space-x-2">
      <i id="toast-icon" data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
      <span id="toast-message" class="text-sm font-medium">Action successful</span>
    </div>
  </div>

  <!-- Projects Table -->
  <div class="rounded-lg border bg-card shadow-sm overflow-x-auto">
    <table class="w-full text-sm text-left">
      <thead class="border-b bg-muted/40 text-muted-foreground font-medium">
        <tr>
          <th class="h-12 px-4 align-middle">Title</th>
          <th class="h-12 px-4 align-middle">Category</th>
          <th class="h-12 px-4 align-middle">Year</th>
          <th class="h-12 px-4 align-middle">Status</th>
          <th class="h-12 px-4 align-middle">Featured</th>
          <th class="h-12 px-4 align-middle text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y" id="projects-table-body">
        <% if (!projects || projects.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-8 text-muted-foreground">
              No projects found. Create your first project!
            </td>
          </tr>
        <% } else { %>
          <% projects.forEach(p => { 
               const year = p.project_date ? p.project_date.split('-')[0] : '';
          %>
            <tr class="hover:bg-muted/30 transition-colors" data-project-id="<%= p.id %>">
              <td class="p-4 font-medium text-foreground"><%= p.title %></td>
              <td class="p-4 text-muted-foreground"><%= p.category %></td>
              <td class="p-4 text-muted-foreground"><%= year %></td>

              <!-- Active Status Switch -->
              <td class="p-4">
                <div class="flex items-center gap-2">
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input 
                      type="checkbox" 
                      class="sr-only toggle-switch" 
                      data-id="<%= p.id %>" 
                      data-field="is_active" 
                      <%= p.is_active ? 'checked' : '' %>>
                    <div class="w-9 h-5 bg-input rounded-full peer peer-checked:bg-primary transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
                  </label>
                  <span class="status-badge inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= p.is_active ? 'bg-primary/20 text-primary' : 'bg-muted text-muted-foreground' %>">
                    <%= p.is_active ? 'Active' : 'Inactive' %>
                  </span>
                </div>
              </td>

              <!-- Featured Status Switch -->
              <td class="p-4">
                <div class="flex items-center gap-2">
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input 
                      type="checkbox" 
                      class="sr-only toggle-switch" 
                      data-id="<%= p.id %>" 
                      data-field="is_featured" 
                      <%= p.is_featured ? 'checked' : '' %>>
                    <div class="w-9 h-5 bg-input rounded-full peer peer-checked:bg-primary transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
                  </label>
                  <span class="featured-badge inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= p.is_featured ? 'bg-primary/20 text-primary' : 'bg-muted text-muted-foreground' %>">
                    <%= p.is_featured ? 'Featured' : 'Normal' %>
                  </span>
                </div>
              </td>

              <!-- Actions -->
              <td class="p-4 text-right space-x-2">
                <button 
                  type="button" 
                  class="btn-edit-project inline-flex items-center justify-center rounded-md text-xs font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-8 px-3 py-1 transition-colors"
                  data-id="<%= p.id %>">
                  Edit
                </button>
                <button 
                  type="button" 
                  class="btn-delete-project inline-flex items-center justify-center rounded-md text-xs font-medium border border-destructive/30 bg-destructive/10 text-destructive hover:bg-destructive hover:text-destructive-foreground h-8 px-3 py-1 transition-colors"
                  data-id="<%= p.id %>">
                  Delete
                </button>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- ==================== PROJECT MODAL ==================== -->
<div id="project-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-card text-card-foreground border shadow-xl rounded-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto p-6 space-y-6">
    <div class="flex items-center justify-between border-b pb-4">
      <h2 id="modal-title" class="text-xl font-bold">Add Project</h2>
      <button id="modal-close-btn" type="button" class="text-muted-foreground hover:text-foreground">
        <i data-lucide="x" class="h-5 w-5"></i>
      </button>
    </div>

    <form id="project-form" class="space-y-6">
      <input type="hidden" id="form-project-id" name="id" value="">

      <!-- Basic Info Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium mb-1">Title *</label>
          <input 
            type="text" 
            id="form-title" 
            name="title" 
            required 
            placeholder="Title *"
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>

        <div>
          <label class="block text-xs font-medium mb-1">Slug</label>
          <input 
            type="text" 
            id="form-slug" 
            name="slug" 
            placeholder="URL Slug"
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>

        <div>
          <label class="block text-xs font-medium mb-1">Category</label>
          <input 
            type="text" 
            id="form-category" 
            name="category" 
            placeholder="e.g. Residential Building, Commercial Building"
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>

        <div>
          <label class="block text-xs font-medium mb-1">Year</label>
          <input 
            type="number" 
            id="form-year" 
            name="year" 
            placeholder="Year"
            value="<%= new Date().getFullYear() %>"
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>

        <div>
          <label class="block text-xs font-medium mb-1">Location</label>
          <input 
            type="text" 
            id="form-location" 
            name="location" 
            placeholder="Location"
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>

        <div>
          <label class="block text-xs font-medium mb-1">Client</label>
          <input 
            type="text" 
            id="form-client" 
            name="client" 
            placeholder="Client Name"
            class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>
      </div>

      <!-- Featured Image Upload -->
      <div class="space-y-2">
        <label class="block font-medium text-sm">Featured Image</label>
        <label class="block cursor-pointer">
          <input type="file" id="featured-image-file" accept="image/*" class="hidden">
          <input type="hidden" id="form-featured-image-url" value="">
          <div id="featured-image-preview-container" class="relative aspect-[16/9] max-h-64 rounded-lg border border-dashed flex items-center justify-center hover:bg-muted/40 transition-colors overflow-hidden bg-muted/20">
            <span id="featured-image-placeholder" class="text-sm text-muted-foreground flex items-center gap-1.5">
              <i data-lucide="upload" class="h-4 w-4"></i>
              Click to upload featured image
            </span>
            <img id="featured-image-preview" src="" alt="Featured preview" class="hidden absolute inset-0 w-full h-full object-cover">
          </div>
        </label>
      </div>

      <!-- Gallery Images Upload -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label class="block font-medium text-sm">Gallery Images (Max 10)</label>
          <button 
            type="button" 
            id="btn-add-gallery-slot"
            class="inline-flex items-center justify-center rounded-md text-xs font-medium border border-input bg-background hover:bg-accent h-8 px-3 py-1">
            <i data-lucide="plus" class="h-3.5 w-3.5 mr-1"></i> Add Image
          </button>
        </div>

        <div id="gallery-slots-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Specifications Builder -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label class="block font-medium text-sm">Specifications</label>
          <button 
            type="button" 
            id="btn-add-spec-row"
            class="inline-flex items-center justify-center rounded-md text-xs font-medium border border-input bg-background hover:bg-accent h-8 px-3 py-1">
            <i data-lucide="plus" class="h-3.5 w-3.5 mr-1"></i> Add Spec
          </button>
        </div>

        <div id="specs-container" class="space-y-2">
          <!-- Dynamically populated spec rows -->
        </div>
      </div>

      <!-- Overview -->
      <div class="space-y-1">
        <label class="block font-medium text-sm">Project Overview</label>
        <textarea 
          id="form-overview" 
          name="overview" 
          rows="5"
          placeholder="Detailed project description and highlights..."
          class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring resize-y"
        ></textarea>
      </div>

      <!-- Form Buttons -->
      <div class="flex justify-end gap-3 pt-4 border-t">
        <button 
          id="btn-modal-cancel" 
          type="button" 
          class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-10 px-4 py-2">
          Cancel
        </button>
        <button 
          id="btn-modal-save" 
          type="submit" 
          class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-6 py-2 transition-colors">
          Save Project
        </button>
      </div>
    </form>
  </div>
</div>

<footer class="border-t py-4 text-center text-xs text-muted-foreground">
  © <%= new Date().getFullYear() %> Vertex Construction Group — Admin Portal
</footer>

</body>
</html>
